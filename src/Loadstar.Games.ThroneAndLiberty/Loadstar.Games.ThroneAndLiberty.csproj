<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Loadstar.Games.ThroneAndLiberty</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Loadstar.Core\Loadstar.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Embedded from docs/, which is exactly what GitHub Pages publishes. ONE copy of the file: the
         app fetches it from the site at runtime and carries these same bytes as the offline fallback.
         A second copy under Data/ would drift, and a schedule stale in one place but current in
         another is worse than one that is uniformly old. LogicalName is explicit because LoadBundled
         finds the resource by name, and a linked file does not get the name the folder would imply. -->
    <EmbeddedResource Include="..\..\docs\boss-schedule.json"
                      LogicalName="Loadstar.Games.ThroneAndLiberty.Data.boss-schedule.json" />
    <!-- The mechanics reference handed to the model. Markdown files rather than string constants so
         they stay readable and reviewable as documents — they are the product's game knowledge, and
         a diff on them should be legible to someone who plays the game. -->
    <EmbeddedResource Include="Knowledge\*.md" />
    <!-- The icon signature index, so equipment identification works on a fresh install with no network.
         Building it needs ~1,500 icons from questlog's CDN; regenerate with the icon-probe switch, which writes
         gear-index.json beside the executable, then commit the result here. See TlGearIndex. -->
    <EmbeddedResource Include="gear-index.json"
                      LogicalName="Loadstar.Games.ThroneAndLiberty.gear-index.json" />
  </ItemGroup>
</Project>
