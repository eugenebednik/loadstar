<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe, not Exe: this lives in the tray and must not own a console window. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Loadstar.App</RootNamespace>
    <AssemblyName>Loadstar</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!--
      Embeds the icon into Loadstar.exe. Without it the executable carried NO icon resource at all, so the
      Start Menu shortcut, the desktop, Explorer and Add/Remove Programs all fell back to the generic Windows
      exe icon while the tray showed the real mark — the app drew its own icon at runtime and the shell never
      saw it.

      The .ico is generated from AppIcon by the exe's own write-icon switch, and committed rather than produced
      during the build, because a build cannot depend on running the thing it is building.
    -->
    <ApplicationIcon>..\..\installer\Loadstar.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loadstar.Core\Loadstar.Core.csproj" />
    <ProjectReference Include="..\Loadstar.Games.ThroneAndLiberty\Loadstar.Games.ThroneAndLiberty.csproj" />
    <ProjectReference Include="..\Loadstar.Capture.Windows\Loadstar.Capture.Windows.csproj" />
  </ItemGroup>

</Project>
