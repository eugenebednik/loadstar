<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net8.0, not net8.0-windows. The posture scanner reads IL metadata off disk rather
         than loading assemblies, so it can inspect the Windows-only capture assembly without
         being Windows-only itself — and Loadstar.Core stays testable off-Windows, which is the
         reason SecretStore is annotated rather than the whole assembly retargeted. -->
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="System.Reflection.Metadata" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Loadstar.Core\Loadstar.Core.csproj" />
    <ProjectReference Include="..\..\src\Loadstar.Games.ThroneAndLiberty\Loadstar.Games.ThroneAndLiberty.csproj" />

    <!-- Built but not referenced. The capture assembly is the one that actually contains native
         calls, so the posture test is worthless if it can run before that assembly exists; forcing
         the build order guarantees there is something to scan. ReferenceOutputAssembly=false plus
         SkipGetTargetFrameworkProperties keeps the net8.0/net8.0-windows mismatch from being an
         error, since we never link against it. -->
    <ProjectReference Include="..\..\src\Loadstar.Capture.Windows\Loadstar.Capture.Windows.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Private="false" />
  </ItemGroup>

</Project>
